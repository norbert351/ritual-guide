# Ritual Chain Configuration
# Copy this to .env and adjust as needed.

# --- Chain ---
RPC_URL=https://rpc.ritualfoundation.org
CHAIN_ID=1979

# --- Agent Identity ---
# Change this for each new agent you deploy
SALT=my-ritual-agent-1

# --- Agent Behavior ---
# What your agent does on every wake cycle
PROMPT="Analyze the latest transactions on Ritual Chain and provide a brief market summary with key insights."

# --- Funding ---
# RITUAL to deposit into the agent's wallet (in wei)
# 0.1 RITUAL = 100000000000000000 (supports ~6-7 wake cycles)
DEPOSIT_WEI=100000000000000000

# Lock duration in blocks (100000 blocks ≈ 9.7 hours at 0.35s/block)
LOCK_BLOCKS=100000

# --- Harness ---
# CLI type: 5 = Crush, 6 = ZeroClaw (recommended)
CLI_TYPE=6

# --- Model ---
# Ritual's free built-in LLM — no external API key needed!
MODEL=zai-org/GLM-4.7-FP8
